# Local-only settings; no credentials are required for the sample pipeline.
PIPELINE_INPUT=
PIPELINE_SOURCE=auto
PIPELINE_OUTPUT_DIR=data/processed

# Optional Apify extraction.
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_INPUT_JSON={}

# Optional MotherDuck load.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=

# Optional Cloudflare R2 upload.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
